# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_NAME=Campus Hub
VITE_PUBLIC_BASE_URL=http://localhost:5173
VITE_RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
VITE_SUPPORT_EMAIL=

# Backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/campus_hub?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=campus_hub
SPRING_DATASOURCE_PASSWORD=campus_hub_local_password
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=1
JWT_REMEMBER_ME_REFRESH_TOKEN_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
OTP_EXPIRY_MINUTES=10
OTP_EXPOSE_DEV_CODES=false
PROFILE_PHOTO_STORAGE_DIRECTORY=./data/profile-photos
LISTING_IMAGE_STORAGE_DIRECTORY=./data/listing-images
SUPPORT_ATTACHMENT_STORAGE_DIRECTORY=./data/support-attachments
CHAT_MAX_MESSAGES_PER_MINUTE=30
RAZORPAY_MOCK_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_test_key_secret
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

# External provider placeholders for staging/production wiring
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=change_me
MAIL_PASSWORD=change_me
MAIL_FROM=no-reply@example.com
SMS_PROVIDER=change_me
SMS_API_KEY=change_me
SMS_SENDER_ID=change_me
CLOUDINARY_CLOUD_NAME=change_me
CLOUDINARY_API_KEY=change_me
CLOUDINARY_API_SECRET=change_me
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
AWS_REGION=ap-south-1
AWS_S3_BUCKET=campus-hub-dev
APP_FRONTEND_URL=http://localhost:5173
APP_BACKEND_URL=http://localhost:8080

# Docker Compose
MYSQL_DATABASE=campus_hub
MYSQL_USER=campus_hub
MYSQL_PASSWORD=campus_hub_local_password
MYSQL_ROOT_PASSWORD=campus_hub_root_local_password
